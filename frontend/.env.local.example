NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_APP_BASE=http://127.0.0.1:3001
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
AUTH_URL=http://127.0.0.1:3001
AUTH_SECRET=replace-with-local-secret
DATABASE_URL=postgresql://user:password@localhost:5432/flowsoundz
CRON_SECRET=replace-with-cron-secret
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
MASTERS_BLOB_READ_WRITE_TOKEN=replace-with-mastering-blob-token
ADMIN_EMAIL=you@example.com
ADMIN_UPLOAD_PASSWORD=replace-with-admin-password
LAUNCH_MODE=false
MAINTENANCE_MODE=false

STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_INSIDER_PRICE_ID=price_replace
STRIPE_VAULT_PRICE_ID=price_replace

GMAIL_USER=replace-with-gmail-user
GMAIL_APP_PASSWORD=replace-with-gmail-app-password
NOTIFY_EMAIL=you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_AUDIO_CDN_BASE=
NEXT_PUBLIC_KOFI_URL=
NEXT_PUBLIC_PATREON_URL=
NEXT_PUBLIC_DEMO_TIER=

# AI and voice providers. Keep secrets server-side; never use NEXT_PUBLIC_ here.
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_MODEL_DJ=gpt-4o
OPENAI_OUTREACH_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=replace-with-elevenlabs-key
ELEVENLABS_VOICE_ID=replace-with-voice-id

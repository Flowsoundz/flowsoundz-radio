NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
AUTH_URL=http://127.0.0.1:3001
AUTH_SECRET=replace-with-local-secret
DATABASE_URL=postgresql://user:password@localhost:5432/flowsoundz
CRON_SECRET=replace-with-cron-secret

# AI and voice providers. Keep secrets server-side; never use NEXT_PUBLIC_ here.
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_MODEL_DJ=gpt-4o
OPENAI_OUTREACH_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=replace-with-elevenlabs-key
ELEVENLABS_VOICE_ID=replace-with-voice-id

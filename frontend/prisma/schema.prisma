generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  LISTENER
  ARTIST
  LABEL_MANAGER
  ADMIN
}

enum LabelTier {
  STARTER
  PRO
}

enum MemberTier {
  FREE
  INSIDER
  VAULT
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(LISTENER)
  tier          MemberTier @default(FREE)
  allowExplicit Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts         Account[]
  sessions         Session[]
  vibePoints       VibePoints?
  vibeTransactions  VibeTransaction[]  @relation("UserVibeTransactions")
  pushSubscriptions PushSubscription[]
  favorites        SongFavorite[]
  labelManagers    LabelManager[]
  artistFollows    ArtistFollow[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

enum SongVibe {
  CHILL
  HYPE
  LATE_NIGHT
  EMOTIONAL
  UNSURE
}

enum ArtistSubmissionStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
}

enum InboxStatus {
  UNREAD
  READ
}

enum ContactTopic {
  ARTIST
  PARTNERSHIP
  GENERAL
}

enum AnalyticsEventName {
  PAGE_VIEW
  START_LISTENING_CLICK
  SUBMISSION_CLICK
  SHARE_TRACK_CLICK
  WAITLIST_SIGNUP
  PROMO_SUBMIT_CLICK
  TRACK_SKIP
  TRACK_COMPLETE
  VISUALIZER_OPEN
  ARTIST_SUBMISSION_STARTED
  ARTIST_SUBMISSION_COMPLETED
  SONG_FAVORITE
}

enum PackagingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  SPOTIFY
  YOUTUBE
  BANDCAMP
  X
  WEBSITE
  OTHER
}

enum SupportPlatform {
  MEMBERSHIP
  PATREON
  BANDCAMP
  PAYPAL
  CRYPTO
  TIPJAR
  OTHER
}

enum VisualizerSessionStatus {
  OFFLINE
  SCHEDULED
  LIVE
  ENDED
}

enum MilestoneGoalType {
  FAVORITES
  SAVES
  SHARES
  STREAMS
  UNLOCKS
  OTHER
}

model Artist {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  bio         String?
  artistType  String?
  email       String?
  socialLink  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile           ArtistProfile?
  songs             Song[]
  socialLinks       ArtistSocialLink[]
  supportLinks      ArtistSupportLink[]
  visualizerSessions ArtistVisualizerSession[]
  analyticsEvents   AnalyticsEvent[]
  payouts           ArtistPayout[]
  labelLinks        LabelArtist[]
  followers         ArtistFollow[]

  @@map("artists")
}

model Song {
  id           String    @id @default(cuid())
  artistId     String
  title        String
  slug         String    @unique
  album        String?
  genre        String
  vibe         SongVibe
  durationSec  Int?
  audioUrl     String
  audioFile    String?
  hlsUrl       String?
  publicAudioUrl String?
  packagingStatus PackagingStatus?
  packagingError String?
  coverUrl     String?
  coverFile    String?
  artistVisualFile String?
  artistVisualUrl String?
  hlsExists    Boolean   @default(false)
  coverExists  Boolean   @default(false)
  artistVisualExists Boolean @default(false)
  isFeatured   Boolean   @default(false)
  isVault      Boolean   @default(false)
  accessTier   String?
  memberReleaseAt DateTime?
  publicReleaseAt DateTime?
  releaseAt    DateTime?
  behindTheMixText String?
  youtubeUrl   String?
  localStream  Boolean   @default(false)
  isExplicit   Boolean   @default(false)
  isAiGenerated Boolean  @default(false)
  aiPlatform   String?
  curatedFallback Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artist            Artist            @relation(fields: [artistId], references: [id], onDelete: Restrict)
  featuredInProfiles ArtistProfile[]  @relation("ArtistProfileFeaturedTrack")
  milestones        SongMilestone[]
  analyticsEvents   AnalyticsEvent[]
  queuePreferences  QueuePreference?
  radioSessions     RadioSession[]
  favorites         SongFavorite[]
  dropNotifies      DropNotify[]

  @@index([artistId])
  @@index([vibe])
  @@index([releaseAt])
  @@map("songs")
}

model ArtistProfile {
  id                String   @id @default(cuid())
  artistId          String   @unique
  statement         String?
  rootsLabel        String?
  heroImageUrl      String?
  heroVideoUrl      String?
  heroVideoPosterUrl String?
  primaryCity       String?
  primaryRegion     String?
  primaryCountry    String?
  primaryMood       String?
  secondaryMoods    String[]
  supportLabel      String?
  featuredTrackId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  artist            Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  featuredTrack     Song?    @relation("ArtistProfileFeaturedTrack", fields: [featuredTrackId], references: [id], onDelete: SetNull)

  @@index([featuredTrackId])
  @@map("artist_profiles")
}

model ArtistSocialLink {
  id          String         @id @default(cuid())
  artistId    String
  platform    SocialPlatform
  label       String?
  url         String
  isPrimary   Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  artist      Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, sortOrder])
  @@map("artist_social_links")
}

model ArtistSupportLink {
  id          String          @id @default(cuid())
  artistId    String
  platform    SupportPlatform
  label       String?
  url         String
  isPrimary   Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  artist      Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, sortOrder])
  @@map("artist_support_links")
}

model ArtistVisualizerSession {
  id          String                  @id @default(cuid())
  artistId    String
  title       String
  status      VisualizerSessionStatus @default(OFFLINE)
  roomUrl     String?
  teaserText  String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  artist      Artist                  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, status])
  @@map("artist_visualizer_sessions")
}

model SongMilestone {
  id                String            @id @default(cuid())
  songId            String
  goalType          MilestoneGoalType @default(FAVORITES)
  goalTarget        Int
  currentCount      Int               @default(0)
  rewardTitle       String
  rewardDescription String?
  rewardUrl         String?
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  song              Song              @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId, isActive, sortOrder])
  @@map("song_milestones")
}

model ArtistSubmission {
  id             String                  @id @default(cuid())
  artistName     String
  contactName    String
  email          String
  songTitle      String
  genre          String
  vibe           SongVibe
  artistType     String
  description    String
  songLink       String
  versionType    String
  producerCredit String?
  streamingLink  String?
  coverArtLink   String?
  socialLink     String?
  aiUsed         Boolean                 @default(false)
  aiTool         String?
  rightsConfirmed Boolean                @default(false)
  samplesConfirmed Boolean               @default(false)
  promotionPermissionConfirmed Boolean   @default(false)
  removalPolicyConfirmed Boolean         @default(false)
  notes          String?
  status         ArtistSubmissionStatus  @default(NEW)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  promoAssets      PromoAsset?
  reviews          SubmissionReview[]
  analyticsEvents  AnalyticsEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("artist_submissions")
}

model SubmissionReview {
  id              String                 @id @default(cuid())
  submissionId    String
  status          ArtistSubmissionStatus
  internalNotes   String?
  artistFeedback  String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())

  submission ArtistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([status])
  @@map("submission_reviews")
}

model PromoAsset {
  id             String   @id @default(cuid())
  submissionId   String   @unique
  artistBio      String
  suggestedVibe  SongVibe
  promoBlurb     String
  radioIntro     String
  socialCaptions Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission ArtistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("promo_assets")
}

model AnalyticsEvent {
  id            String              @id @default(cuid())
  eventName     AnalyticsEventName
  songId        String?
  artistId      String?
  submissionId  String?
  sessionId     String?
  url           String
  properties    Json?
  createdAt     DateTime            @default(now())

  song        Song?             @relation(fields: [songId], references: [id], onDelete: SetNull)
  artist      Artist?           @relation(fields: [artistId], references: [id], onDelete: SetNull)
  submission  ArtistSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([songId])
  @@index([artistId])
  @@index([submissionId])
  @@index([createdAt])
  @@map("analytics_events")
}

model ContactMessage {
  id        String      @id @default(cuid())
  topic     ContactTopic
  name      String
  email     String
  message   String
  status    InboxStatus @default(UNREAD)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("contact_messages")
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String
  earlyAccess Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("waitlist_entries")
}

model QueuePreference {
  id            String   @id @default(cuid())
  songId        String   @unique
  skipRate      Float    @default(0)
  completeRate  Float    @default(0)
  playCount     Int      @default(0)
  hypeCount     Int      @default(0)
  lastPlayedAt  DateTime?
  rotationScore Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([rotationScore])
  @@map("queue_preferences")
}

enum ReleaseSubmissionStatus {
  RECEIVED
  REVIEWED
  APPROVED
  REJECTED
}

model ReleaseSubmission {
  id               String                  @id @default(cuid())
  artistName       String
  trackTitle       String
  genre            String
  releaseDate      String
  email            String
  notes            String?
  lyrics           String?
  productionMethod String?   // self_produced | ai_assisted | ai_generated
  audioFile        String?
  coverFile        String?
  status           ReleaseSubmissionStatus @default(RECEIVED)
  internalNotes    String?
  aiSummary        String?
  aiTags           String[]
  aiRecommendation String?
  aiConfidence     String?
  aiGeneratedAt    DateTime?
  aiModel          String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("release_submissions")
}

enum VibeReason {
  LISTEN_5MIN
  VOTE
  SHARE
  QUEUE_BOOST
}

model VibePoints {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vibe_points")
}

model VibeTransaction {
  id        String     @id @default(cuid())
  userId    String
  delta     Int
  reason    VibeReason
  createdAt DateTime   @default(now())

  user      User       @relation("UserVibeTransactions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("vibe_transactions")
}

model QueueBoost {
  id        String   @id @default(cuid())
  trackId   String   @unique
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([score])
  @@map("queue_boosts")
}

model RadioSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  currentSongId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currentSong Song? @relation(fields: [currentSongId], references: [id], onDelete: SetNull)

  @@index([currentSongId])
  @@index([lastSeenAt])
  @@map("radio_sessions")
}

model SongRequest {
  id        String   @id @default(cuid())
  songId    String
  ip        String
  createdAt DateTime @default(now())

  @@unique([songId, ip])
  @@index([songId])
  @@map("song_requests")
}

model SongFavorite {
  id        String   @id @default(cuid())
  songId    String
  userId    String?
  ip        String
  createdAt DateTime @default(now())

  song Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([songId, ip])
  @@index([songId])
  @@index([userId])
  @@map("song_favorites")
}

model ChatMessage {
  id          String   @id @default(cuid())
  displayName String
  text        String
  trackTitle  String?
  role        String   @default("LISTENER")
  ip          String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("chat_messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Artist Follow ────────────────────────────────────────────────────────────

model ArtistFollow {
  id        String   @id @default(cuid())
  artistId  String
  userId    String?
  ip        String
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([artistId, ip])
  @@index([artistId])
  @@index([userId])
  @@map("artist_follows")
}

// ─── Drop Notify ──────────────────────────────────────────────────────────────

model DropNotify {
  id         String    @id @default(cuid())
  songId     String
  endpoint   String
  ip         String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, endpoint])
  @@index([songId])
  @@map("drop_notifies")
}

// ─── Revenue Share ────────────────────────────────────────────────────────────

model RevenuePool {
  id           String   @id @default(cuid())
  month        String   // "YYYY-MM"
  totalRevenue Float    // gross subscription revenue that month (USD)
  artistPool   Float    // amount reserved for artist payouts
  distributed  Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payouts ArtistPayout[]

  @@unique([month])
  @@map("revenue_pools")
}

model ArtistPayout {
  id              String   @id @default(cuid())
  poolId          String
  artistId        String
  month           String
  playCount       Int
  totalPlays      Int
  playShare       Float
  estimatedAmount Float
  paid            Boolean  @default(false)
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  pool   RevenuePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  artist Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([poolId, artistId])
  @@index([artistId])
  @@index([month])
  @@map("artist_payouts")
}

// ─── Label / Agency ───────────────────────────────────────────────────────────

model Label {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  email            String    @unique
  tier             LabelTier @default(STARTER)
  stripeCustomerId String?
  maxArtists       Int       @default(5)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  managers LabelManager[]
  artists  LabelArtist[]

  @@map("labels")
}

model LabelManager {
  id        String   @id @default(cuid())
  labelId   String
  userId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labelId, userId])
  @@index([userId])
  @@map("label_managers")
}

model LabelArtist {
  id        String   @id @default(cuid())
  labelId   String
  artistId  String
  createdAt DateTime @default(now())

  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([labelId, artistId])
  @@index([labelId])
  @@map("label_artists")
}

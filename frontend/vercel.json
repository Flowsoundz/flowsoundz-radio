{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && node scripts/generate-narration-manifest.mjs && node scripts/generate-bed-manifest.mjs && next build --webpack",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 12 */2 * *"
    },
    {
      "path": "/api/cron/pregame-drops",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/artist-digest",
      "schedule": "0 15 * * 1"
    }
  ]
}

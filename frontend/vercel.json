{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma db push && next build",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 12 */2 * *"
    },
    {
      "path": "/api/cron/pregame-drops",
      "schedule": "0 13 * * *"
    }
  ]
}

# Same Neon connection string the Next.js app uses (Prisma DATABASE_URL).
DATABASE_URL=postgresql://...

# Vercel Blob read/write token. Create in the Vercel dashboard:
# Storage → your Blob store → Tokens. The Next.js app uses the same store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: idle poll interval in ms (default 8000).
POLL_MS=8000
